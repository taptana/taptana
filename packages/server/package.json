{
  "name": "@taptana/server",
  "version": "1.0.0",
  "description": "CLI y servidor de Taptana: sirve tus prototipos, graba sesiones en SQLite y muestra el panel.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "taptana": "./dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "seed",
    "example"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --test \"dist/**/*.test.js\"",
    "dev": "pnpm build && node dist/cli.js dev",
    "start": "node dist/cli.js start",
    "seed": "pnpm build && node dist/cli.js seed",
    "clean": "rm -rf dist public/recorder.js public/recorder.js.map public/panel example"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@taptana/shared": "workspace:*",
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@taptana/recorder": "workspace:*",
    "@taptana/web": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.9.0"
  }
}
