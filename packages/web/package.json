{
  "name": "@taptana/web",
  "version": "0.1.0",
  "description": "Panel de Taptana: lista de sesiones y reproductor. React + Vite + shadcn.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:pages": "TAPTANA_MODE=static TAPTANA_BASE=${TAPTANA_BASE:-/} vite build --outDir dist-pages",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"web: se prueba end-to-end desde el server\"",
    "clean": "rm -rf dist dist-pages"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@taptana/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrweb-player": "^2.2.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@rrweb/types": "^2.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
