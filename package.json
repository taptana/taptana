{
  "name": "taptana-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Pruebas de usabilidad para prototipos HTML, mobile first. Open source (MIT).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @taptana/server dev ./examples/tienda",
    "seed": "pnpm --filter @taptana/server seed",
    "seed:record": "node scripts/record-seed.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "site": "node scripts/build-site.mjs",
    "e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "clean": "pnpm -r clean && rm -rf site"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
