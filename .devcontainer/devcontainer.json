{
  "name": "Taptana",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.28.0 --activate && pnpm install && pnpm build && pnpm seed",
  "forwardPorts": [4321, 5173],
  "portsAttributes": {
    "4321": { "label": "Taptana (prototipo + panel)", "onAutoForward": "notify", "visibility": "public" },
    "5173": { "label": "Panel (Vite dev)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
